# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments — configure any subset. Each provider that has a secret key appears
# on the checkout picker; with none set, checkout runs in simulated demo mode.

# Stripe (cards; not available to merchants in much of Africa)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Paystack (cards + mobile money; Ghana, Nigeria, and more)
# Webhook URL to register in the Paystack dashboard: /api/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_test_xxx

# Flutterwave (cards + mobile money + bank; much of Africa)
# Webhook URL to register: /api/webhooks/flutterwave
# FLUTTERWAVE_WEBHOOK_HASH must match the "Secret hash" set in the FLW dashboard.
FLUTTERWAVE_SECRET_KEY=FLWSECK_test-xxx
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash

# Currency all charges are created in (ISO 4217). Product prices are minor units
# of this currency. Defaults to USD. For a Ghana store, set GHS.
NEXT_PUBLIC_PAYMENT_CURRENCY=USD

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
